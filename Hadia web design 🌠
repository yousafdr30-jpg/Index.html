<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hadia.Design | Web Design Portfolio</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f8f7ff;
      color: #24213e;
      line-height: 1.7;
    }

    header {
      padding: 22px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
    }

    .logo span {
      color: #7357ed;
    }

    nav a {
      color: #24213e;
      text-decoration: none;
      font-weight: bold;
    }

    .hero {
      padding: 85px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      flex-wrap: wrap;
    }

    .hero-text {
      flex: 1 1 300px;
    }

    .tag {
      color: #7357ed;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    h1 {
      font-size: clamp(40px, 6vw, 65px);
      line-height: 1.15;
      margin: 18px 0;
    }

    h1 span {
      color: #7357ed;
    }

    .hero-text p {
      color: #66627d;
      font-size: 17px;
      margin-bottom: 25px;
    }

    .button {
      display: inline-block;
      padding: 12px 22px;
      margin: 5px 5px 5px 0;
      border-radius: 10px;
      background: #7357ed;
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    .button.outline {
      background: transparent;
      color: #7357ed;
      border: 2px solid #7357ed;
    }

    .hero-card {
      flex: 1 1 250px;
      min-height: 280px;
      padding: 35px;
      border-radius: 25px;
      background: #e5ddff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .hero-card h2 {
      color: #7357ed;
      font-size: 75px;
    }

    section {
      padding: 65px 7%;
    }

    .section-heading {
      font-size: 35px;
      margin-bottom: 12px;
    }

    .section-description {
      color: #66627d;
      margin-bottom: 30px;
    }

    .services,
    .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 22px;
    }

    .service {
      padding: 25px;
      background: white;
      border: 1px solid #e9e5fa;
      border-radius: 18px;
    }

    .service .icon {
      font-size: 35px;
    }

    .service h3 {
      margin: 12px 0;
    }

    .service p {
      color: #66627d;
    }

    .project {
      min-height: 220px;
      padding: 25px;
      border-radius: 18px;
      color: white;
      background: linear-gradient(135deg, #7357ed, #aaa0ff);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .project.green {
      background: linear-gradient(135deg, #087f73, #58cdb5);
    }

    .project.pink {
      background: linear-gradient(135deg, #bd5b85, #f0a7c7);
    }

    .project-label {
      padding: 12px;
      border: 1px solid #ffffff80;
      border-radius: 10px;
      background: #ffffff20;
    }

    .contact-box {
      padding: 40px;
      border-radius: 25px;
      background: #e5ddff;
    }

    .contact-box p {
      margin: 12px 0;
    }

    .email {
      color: #5137c9;
      font-weight: bold;
      overflow-wrap: anywhere;
    }

    footer {
      padding: 25px 7%;
      text-align: center;
      color: #66627d;
    }

    @media (max-width: 600px) {
      .hero {
        padding-top: 55px;
      }

      .contact-box {
        padding: 25px;
      }

      .section-heading {
        font-size: 29px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Hadia<span>.</span>Design</div>
    <nav>
      <a href="#contact">Contact ↗</a>
