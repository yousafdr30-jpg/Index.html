            </p>
          </div>
        </div>

      </div>
    </section>

    <section id="contact">
      <div class="contact-box">

        <div class="tag">Get In Touch</div>

        <h2 class="section-heading">
          Have a project in mind?
        </h2>

        <p>
          Interested in website design or collaboration?
          Contact me through email or Pinterest.
        </p>

        <a
          class="button"
          href="mailto:yousafayesha486@gmail.com?subject=Website%20Design%20Enquiry">
          Email Me
        </a>

        <a
          class="button outline"
          href="https://www.pinterest.com/"
          target="_blank"
          rel="noopener noreferrer">
          Msg Me on Pinterest
        </a>

        <p>
          <strong>Email:</strong>
          <a
            class="email"
            href="mailto:yousafayesha486@gmail.com">
            yousafayesha486@gmail.com
          </a>
        </p>

        <p>
          <strong>Contact:</strong>
          Msg me on Pinterest
        </p>

      </div>
    </section>

  </main>

  <footer>
    © 2026 Hadia.Design | Web Design & Collaborations
  </footer>

</body>
</html>
